// 2-Deck in three layers. Row 1, always shown: each deck's header over one
// row with LOOP, CUE, PLAY and a mini jog, either side of the slim mixer,
// whose outer edges carry each deck's tempo (MixerTempo). Layer 2, the PADS
// button: each deck's pads (PadBarHalf) with an X-Y FX pad under the mixer
// (XyFxPad). Layer 3, the FX button: the FX bar (fxbar.slint). A deck
// holding a Groove Box or an instrument shows the full deck instead (see
// main.slint).
import { Theme } from "theme.slint";
import { ControlButton, ControlFader, Controls, Crossfader, HeadphoneIcon, StereoMeter, SyncButton } from "controls.slint";
import { DeckInfo, Header, Jog, LoopStepper, Pads, PlayButton, TempoPanelMenu } from "deck.slint";
import { Knob, ModeMenu, SideKnob } from "mixer.slint";
import { TrackDrag } from "library.slint";
import { MapMark } from "mapmark.slint";
import { TourMark } from "tourmark.slint";
import { InstrumentsUi } from "instruments.slint";

// The heights of the row of decks and of the pad bar.
export global LiteUi {
    out property <length> deck-height: 176px;
    out property <length> bar-height: 104px;
    // JOG on the top bar: a big jog on the inner side of each deck's header,
    // as tall as the cover, in place of the mini jog in row 1.
    in-out property <bool> jogs: false;
    // Each deck's tempo column on the mixer's outer edges (MixerTempo).
    out property <length> tempo-width: 62px;
    // The mixer with its two tempo columns, for the X-Y pad and the Beat FX
    // under it: 254px + 2 × (tempo-width + 1px).
    out property <length> centre-width: 254px + 2 * (tempo-width + 1px);
}

// With JOG on: a big jog beside the header on the mixer side, as tall as
// the cover, with no text in it.
component LiteJog inherits Rectangle {
    in property <string> group;
    in property <DeckInfo> info;
    in property <color> tint;
    in property <angle> spin;
    background: Theme.panel;
    width: self.height;
    Jog {
        group: group;
        info: info;
        tint: tint;
        spin: spin;
        plain: true;
        width: parent.height - 12px;
        height: self.width;
    }
}

// The mini jog under the cover at the outer end of row 1: a dark disc in
// a square box with a thin outline, whose one line turns with the
// playhead, nothing written in it.
component MiniJog inherits Rectangle {
    in property <DeckInfo> info;
    in property <angle> spin;
    width: 58px;
    height: 58px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    Rectangle {
        width: 48px;
        height: 48px;
        border-radius: self.width / 2;
        background: Theme.n-0a0a0b;
        border-width: 3px;
        border-color: Theme.n-48484c;
    }
    if info.loaded: Path {
        width: 48px;
        height: 48px;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke: Theme.n-9e9ea3;
        stroke-width: 4px;
        MoveTo { x: 50 + 16 * sin(spin); y: 50 - 16 * cos(spin); }
        LineTo { x: 50 + 40 * sin(spin); y: 50 - 40 * cos(spin); }
    }
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.n-2a2a2d;
    }
}

// The loop length box with LOOP over it.
component LiteLoop inherits VerticalLayout {
    in property <string> group;
    in property <DeckInfo> info;
    alignment: center;
    spacing: 3px;
    width: 104px;
    Text { text: "LOOP"; color: Theme.text-dim; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; horizontal-alignment: center; }
    LoopStepper { group: group; info: info; height: 34px; }
}

// One deck's tempo on the mixer's outer edge: the BPM and its tempo panel
// (TempoPanelMenu) on top, the tempo fader the full height under them, and
// SYNC at the foot. Right-click the fader for key lock, as in 2-Deck.
export component MixerTempo inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <bool> mirrored;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    property <int> keylock-index: Controls.resolve(group, "keylock");
    background: Theme.panel;
    width: LiteUi.tempo-width;
    VerticalLayout {
        padding: 5px;
        padding-top: 4px;
        spacing: 2px;
        Text { text: info.loaded ? info.bpm : "--"; color: Theme.text; font-size: 13px; font-weight: 600; font-family: "Inter Tabular"; horizontal-alignment: center; height: 16px; vertical-alignment: center; }
        TempoPanelMenu { group: group; info: info; tint: tint; mirrored: mirrored; }
        Rectangle {
            vertical-stretch: 1;
            ControlFader {
                x: (parent.width - self.width) / 2;
                y: 2px;
                width: 36px;
                height: parent.height - 4px;
                group: group;
                key: "rate";
                center-mark: true;
                ticks: 9;
                tint: tint;
                glowing: Controls.value(keylock-index, Controls.tick) > 0;
                context-menu(x, y) => { Controls.toggle(keylock-index); }
            }
        }
        SyncButton { group: group; tint: tint; menu-right-aligned: mirrored; font-size: 11px; height: 24px; tour-id: group + ",sync_enabled"; }
    }
}

// Under the mixer in the pads layer: the Beat FX on an X-Y pad, as on djay.
// Pressing turns the Beat FX on, across sets its length in beats (1/16 to
// 4) or its first setting when it has no beats, up and down its D/W;
// letting go turns it off again unless it was on already.
export component XyFxPad inherits Rectangle {
    property <string> fx: "[EffectRack1_EffectUnit5_Effect1]";
    property <int> enabled-index: Controls.resolve(fx, "enabled");
    property <int> beats-index: Controls.resolve(fx, "beats");
    property <int> meta-index: Controls.resolve(fx, "meta");
    property <int> param-index: Controls.resolve(fx, "parameter1");
    property <float> beats: Controls.value(beats-index, Controls.tick);
    property <bool> was-on;
    property <bool> held: touch.pressed;
    property <float> px: 0.5;
    property <float> py: 0.5;
    background: Theme.panel;
    width: LiteUi.centre-width;
    function apply(x: length, y: length) {
        root.px = clamp(x / grid.width, 0, 1);
        root.py = clamp(y / grid.height, 0, 1);
        if beats > 0 {
            Controls.set-value(beats-index, pow(2, min(6, floor(root.px * 7)) - 4));
        } else {
            Controls.set-value(param-index, root.px);
        }
        Controls.set-value(meta-index, 1 - root.py);
    }
    grid := Rectangle {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.n-0a0a0b;
        for i in 3: Rectangle { x: (i + 1) * parent.width / 4; y: 0; width: 1px; height: parent.height; background: Theme.n-232326; }
        for i in 3: Rectangle { x: 0; y: (i + 1) * parent.height / 4; width: parent.width; height: 1px; background: Theme.n-232326; }
        Text { x: 8px; y: parent.height - 16px; text: "X-Y BEAT FX"; color: Theme.text-dim; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; }
        Text { x: parent.width - self.width - 8px; y: parent.height - 16px; text: beats > 0 ? "← beats · D/W ↑" : "← setting · D/W ↑"; color: Theme.text-dim; font-size: 9px; }
        Rectangle {
            x: root.px * parent.width - self.width / 2;
            y: root.py * parent.height - self.height / 2;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: held ? Theme.lilac : Theme.lilac.transparentize(0.6);
        }
        touch := TouchArea {
            pointer-event(e) => {
                if e.button != PointerEventButton.left {
                    return;
                }
                if e.kind == PointerEventKind.down {
                    root.was-on = Controls.value(enabled-index, Controls.tick) > 0;
                    Controls.set-value(enabled-index, 1);
                    apply(self.mouse-x, self.mouse-y);
                } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                    if !root.was-on {
                        Controls.set-value(enabled-index, 0);
                    }
                }
            }
            moved => {
                if self.pressed {
                    apply(self.mouse-x, self.mouse-y);
                }
            }
        }
    }
}

export component LiteDeck inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    in property <bool> mirrored: false;
    in property <angle> spin;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    // Files dragged in from Finder or a file manager (see TrackDrag.files-over).
    property <bool> under-files: TrackDrag.files-x >= self.absolute-position.x && TrackDrag.files-x < self.absolute-position.x + self.width
        && TrackDrag.files-y >= self.absolute-position.y && TrackDrag.files-y < self.absolute-position.y + self.height;
    property <bool> files-here: TrackDrag.files-over && under-files;
    property <int> files-dropped: TrackDrag.files-dropped;
    changed files-dropped => {
        if under-files {
            TrackDrag.drop-files(deck);
        }
    }
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) || InstrumentsUi.item(e.data) >= 0 ? DragAction.copy : DragAction.none }
        dropped(e) => {
            if InstrumentsUi.item(e.data) >= 0 {
                InstrumentsUi.drop(deck, InstrumentsUi.item(e.data));
            } else {
                TrackDrag.drop(deck, e.data);
            }
            TrackDrag.active = false;
            InstrumentsUi.dragging = false;
            DragAction.copy
        }
    }
    VerticalLayout {
        spacing: 1px;
        HorizontalLayout {
            spacing: 1px;
            if mirrored && LiteUi.jogs: LiteJog { group: group; info: info; tint: tint; spin: spin; height: header.height; }
            header := Header { deck: deck; info: info; overview: overview; mirrored: mirrored; group: group; beat-counter: false; horizontal-stretch: 1; }
            if !mirrored && LiteUi.jogs: LiteJog { group: group; info: info; tint: tint; spin: spin; height: header.height; }
        }
        Rectangle {
            background: Theme.panel;
            vertical-stretch: 1;
            // Outside in: the boxed mini jog under the cover, then CUE and
            // PLAY by the mixer, with LOOP in the middle of the row.
            VerticalLayout {
            alignment: center;
            HorizontalLayout {
                height: 60px;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                if mirrored: PlayButton { group: group; tint: tint; width: 72px; height: 38px; y: (parent.height - self.height) / 2; tour-id: group + ",play"; }
                if mirrored: ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: tint; outline-when-lit: true; font-size: 14px; width: 72px; height: 38px; y: (parent.height - self.height) / 2; }
                if !mirrored: Rectangle {
                    width: 96px;
                    if !LiteUi.jogs: MiniJog { info: info; spin: spin; }
                }
                Rectangle { horizontal-stretch: 1; }
                if mirrored: Rectangle {
                    width: 96px;
                    if !LiteUi.jogs: MiniJog { info: info; spin: spin; }
                }
                if !mirrored: ControlButton { group: group; key: "cue_default"; text: "CUE"; momentary: true; tint: tint; outline-when-lit: true; font-size: 14px; width: 72px; height: 38px; y: (parent.height - self.height) / 2; }
                if !mirrored: PlayButton { group: group; tint: tint; width: 72px; height: 38px; y: (parent.height - self.height) / 2; tour-id: group + ",play"; }
            }
            }
            LiteLoop { group: group; info: info; x: (parent.width - self.width) / 2; height: parent.height; }
        }
    }
    if TrackDrag.active || InstrumentsUi.dragging || TrackDrag.files-over || drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: drop.has-drag || files-here ? 3px : 2px;
        border-color: drop.has-drag || files-here ? tint : tint.transparentize(0.55);
        background: drop.has-drag || files-here ? tint.transparentize(0.9) : transparent;
    }
}

// Headphone cue under a channel fader: just the icon, lilac while on.
component LiteCue inherits Rectangle {
    in property <string> group;
    property <int> index: Controls.resolve(group, "pfl");
    property <bool> lit: Controls.value(index, Controls.tick) > 0;
    width: 30px;
    height: 18px;
    HeadphoneIcon { size: 16px; tint: lit ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-dim; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Controls.set-value(index, lit ? 0 : 1); }
    }
    TourMark { id: group + ",pfl"; }
    MapMark { key: group + ",pfl"; }
}

// A channel by the meters: a small gain knob on top of a short fader, with
// the headphone cue under it.
component LiteChannel inherits VerticalLayout {
    in property <string> group;
    in property <color> tint;
    in property <length> knob: 16px;
    spacing: 2px;
    Knob { group: group; key: "pregain"; size: knob; tour-id: group + ",pregain"; }
    HorizontalLayout {
        alignment: center;
        vertical-stretch: 1;
        ControlFader { group: group; key: "volume"; tint: tint; ticks: 7; width: 30px; tour-id: group + ",volume"; }
    }
    LiteCue { group: group; }
}

// The EQ knobs down one side (or stems or sculpt), smaller than in 2-Deck;
// the filter is by the crossfader.
component LiteSide inherits VerticalLayout {
    in property <int> deck;
    in property <length> size: 16px;
    width: 46px;
    alignment: space-between;
    for place in 3: SideKnob { deck: deck; place: place; size: size; }
}

// The slim mixer: the EQ knobs down the outsides, gain over each fader and
// the headphone cue under it, the knob mode over the meters right between
// the faders, and the crossfader along the bottom with a bigger filter
// knob either side. As wide as 2-Deck's, so the Beat FX
// under it lines up. Tall when the pads show: it then runs down between the
// two halves of the pad bar, with bigger knobs and longer faders.
export component LiteMixer inherits Rectangle {
    property <length> knob: 16px;
    background: Theme.panel;
    width: 254px;
    VerticalLayout {
        padding: 6px;
        padding-top: 4px;
        spacing: 2px;
        HorizontalLayout {
            vertical-stretch: 1;
            LiteSide { deck: 0; size: knob; }
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                LiteChannel { group: "[Channel1]"; tint: Theme.deck1; knob: knob; }
                VerticalLayout {
                    spacing: 3px;
                    width: 34px;
                    ModeMenu { height: 16px; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        vertical-stretch: 1;
                        StereoMeter { group: "[Channel1]"; }
                        StereoMeter { group: "[Channel2]"; }
                    }
                }
                LiteChannel { group: "[Channel2]"; tint: Theme.deck2; knob: knob; }
            }
            LiteSide { deck: 1; size: knob; }
        }
        HorizontalLayout {
            spacing: 4px;
            SideKnob { deck: 0; place: 3; size: 24px; width: 46px; }
            Rectangle {
                horizontal-stretch: 1;
                Crossfader { x: 4px; width: parent.width - 8px; height: 22px; tour-id: "[Master],crossfader"; }
            }
            SideKnob { deck: 1; place: 3; size: 24px; width: 46px; }
        }
    }
}

// One deck's pads in the pads layer, under that deck: tabs over two rows of
// four, as on most controllers. The loop is in row 1.
export component PadBarHalf inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <bool> mirrored;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    background: Theme.panel;
    horizontal-stretch: 1;
    min-width: 0px;
    HorizontalLayout {
        padding: 6px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Pads { deck: deck; group: group; info: info; horizontal-stretch: 1; }
    }
}
