// 2-Deck in 250 pt: each deck's header (100 pt), then one row under it,
// from the outer edge in: the tempo fader with SYNC and the tempo % over
// it, a small pad grid with its pages named across the top, the loop, and
// the jog (its BPM is the deck's BPM readout) with PLAY and CUE under it.
// The mixer runs the full height between the decks; the FX have their own
// row (the FX bar). A deck holding a Groove Box or an instrument shows the
// full deck instead (see main.slint).
import { Theme } from "theme.slint";
import { ControlFader, Controls, SyncButton } from "controls.slint";
import { DeckInfo, Header, JogSection, LoopSection, Pads, TempoPanelMenu } from "deck.slint";
import { TrackDrag } from "library.slint";
import { InstrumentsUi } from "instruments.slint";

export global LiteUi {
    // Header 100 + 1 + the row under it, 149.
    out property <length> deck-height: 250px;
    // The tempo column on the outer edge.
    out property <length> tempo-width: 56px;
    // The pad grid: small, as the pads never need to be big.
    out property <length> pads-width: 250px;
    // The mixer (Mixer with slim), which the Beat FX under it matches.
    out property <length> mixer-width: 280px;
    // The old JOG button's setting, kept for its saved value; the jog is
    // always in the row now.
    in-out property <bool> jogs: false;
}

// One deck's tempo on the outer edge: SYNC and the tempo % (its menu opens
// the tempo panel) over the fader. Right-click the fader for key lock.
component DeckTempo inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <bool> mirrored;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    property <int> keylock-index: Controls.resolve(group, "keylock");
    background: Theme.panel;
    width: LiteUi.tempo-width;
    VerticalLayout {
        padding: 5px;
        spacing: 4px;
        SyncButton { group: group; tint: tint; menu-right-aligned: mirrored; font-size: 11px; height: 26px; tour-id: group + ",sync_enabled"; }
        TempoPanelMenu { group: group; info: info; tint: tint; mirrored: mirrored; }
        Rectangle {
            vertical-stretch: 1;
            ControlFader {
                width: 36px;
                height: parent.height;
                group: group;
                key: "rate";
                center-mark: true;
                ticks: 9;
                tint: tint;
                glowing: Controls.value(keylock-index, Controls.tick) > 0;
                context-menu(x, y) => { Controls.toggle(keylock-index); }
            }
        }
    }
}

export component LiteDeck inherits Rectangle {
    in property <int> deck;
    in property <DeckInfo> info;
    in property <image> overview;
    in property <bool> mirrored: false;
    in property <angle> spin;
    out property <length> overview-width: header.overview-width;
    out property <length> overview-height: header.overview-height;
    property <string> group: "[Channel" + (deck + 1) + "]";
    property <color> tint: Theme.deck-color(deck);
    // Files dragged in from Finder or a file manager (see TrackDrag.files-over).
    property <bool> under-files: TrackDrag.files-x >= self.absolute-position.x && TrackDrag.files-x < self.absolute-position.x + self.width
        && TrackDrag.files-y >= self.absolute-position.y && TrackDrag.files-y < self.absolute-position.y + self.height;
    property <bool> files-here: TrackDrag.files-over && under-files;
    property <int> files-dropped: TrackDrag.files-dropped;
    changed files-dropped => {
        if under-files {
            TrackDrag.drop-files(deck);
        }
    }
    drop := DropArea {
        can-drop(e) => { TrackDrag.accepts(e.data) || InstrumentsUi.item(e.data) >= 0 ? DragAction.copy : DragAction.none }
        dropped(e) => {
            if InstrumentsUi.item(e.data) >= 0 {
                InstrumentsUi.drop(deck, InstrumentsUi.item(e.data));
            } else {
                TrackDrag.drop(deck, e.data);
            }
            TrackDrag.active = false;
            InstrumentsUi.dragging = false;
            DragAction.copy
        }
    }
    VerticalLayout {
        spacing: 1px;
        header := Header { deck: deck; info: info; overview: overview; mirrored: mirrored; group: group; beat-counter: false; slim: true; }
        HorizontalLayout {
            spacing: 1px;
            vertical-stretch: 1;
            if !mirrored: DeckTempo { deck: deck; info: info; }
            Rectangle {
                background: Theme.panel;
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding: 6px;
                    spacing: 10px;
                    if !mirrored: Pads { deck: deck; group: group; info: info; tab-font: 9px; width: LiteUi.pads-width; }
                    if mirrored: JogSection { group: group; mirrored: true; info: info; tint: tint; spin: spin; }
                    Rectangle { horizontal-stretch: 1; }
                    LoopSection { group: group; info: info; tint: tint; mirrored: mirrored; }
                    Rectangle { horizontal-stretch: 1; }
                    if !mirrored: JogSection { group: group; info: info; tint: tint; spin: spin; }
                    if mirrored: Pads { deck: deck; group: group; info: info; tab-font: 9px; width: LiteUi.pads-width; }
                }
            }
            if mirrored: DeckTempo { deck: deck; info: info; mirrored: true; }
        }
    }
    if TrackDrag.active || InstrumentsUi.dragging || TrackDrag.files-over || drop.has-drag: Rectangle {
        border-radius: Theme.radius + 2px;
        border-width: drop.has-drag || files-here ? 3px : 2px;
        border-color: drop.has-drag || files-here ? tint : tint.transparentize(0.55);
        background: drop.has-drag || files-here ? tint.transparentize(0.9) : transparent;
    }
}
